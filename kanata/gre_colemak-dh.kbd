(deflayer gre
@lfun   f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 _
_      1  2  3  4  5  6  7  8  9  0  -  _  _

_      @ς @hο- @φ @π @β @ξ @λ @υ @hς @;or' @х @ъ @sym
@hyp   @α @ρ @σ @τ @γ @μ @hξ @ε @ι @ο @'or; \
_      @ζ @χ @ψ @δ @ν < @κ @η @s1 @s2 @s3 rsft
_               _ @lfun @lcmd @nav @rcmd @sym
)

(defalias
  ς q
  μ m
  ζ z
  π p
  δ d
  ρ r
  λ l
  χ x
  ι i
  ο o
  ε e
  β b
  τ t
  ξ j
  φ f
  κ k
  υ u
  ν n
  ψ c
  η h
  α a
  σ s
  ω v
  γ g
  θ y

  ῎ ;

  ;; modtaps (GCAS)
  hφ (tap-hold $tap-time $hold-ring @φ (multi lctl (layer-while-held eng)))
  hδ (tap-hold $tap-time $hold-pinky @δ (multi lalt (layer-while-held eng)))
  hσ (tap-hold $tap-time $hold-middle @σ (multi lmet (layer-while-held eng)))
  hλ (tap-hold $tap-time $hold-middle @λ (multi lmet (layer-while-held eng)))
  hκ (tap-hold $tap-time $hold-pinky @κ (multi lalt (layer-while-held eng)))
  hξ (tap-hold $tap-time $hold-ring @ξ (multi lctl (layer-while-held eng)))
  hα (tap-hold $tap-time $hold-ring @α (layer-toggle app))
  hο- (tap-hold $tap-time $hold-pinky _ (layer-toggle swi))
  h´ (tap-hold $tap-time $hold-pinky _ (layer-toggle app))
  hς (tap-hold $tap-time $hold-pinky @ς (layer-toggle fun))
)
