(defsrc
 esc   f1  f2  f3  f4  f5      f6  f7  f8  f9  f10    f11 f12 del
 f24   1   2   3   4   5       6   7   8   9   0      -   =   bspc

 tab   q   w   e   r   t       y   u   i   o   p      [   ]   ret
 caps  a   s   d   f   g       h   j   k   l   ;      '   \
 lsft  `   z   x   c   v   b   n   m   ,   .   /      rsft

 rctl   lctl  lalt  lmet  spc  rmet  ralt
)

;; BUTTON DEFINITIONS ==================================================================

;; -------------------------------------------------------------------------------------
;; home row mods, settings

(defvar
  tap-time 200
  hold-time 200
  chord-time 40

  hold-index 200
  hold-middle 200
  hold-ring 180
  hold-pinky 220
)

(include hyper.kbd)
(include control.kbd)
(include symbols.kbd)


(defalias
  ;; -------------------------------------------------------------------------------------
  ;; layouts switching

  eng (multi (layer-switch eng) (macro @en 50))
  rus (multi (layer-switch rus) (macro @ru 50))
  gre (multi (layer-switch gre) (macro @gr 50))
  qwe (multi (layer-switch qwe) @en)

  ;; -------------------------------------------------------------------------------------
  ;; switchers to sublayers

  lsym (tap-hold $tap-time $hold-time spc (layer-toggle sym))
  rsym (tap-hold $tap-time $hold-time ret (layer-toggle sym))
  sym (tap-hold $tap-time $hold-time ret (layer-toggle sym))
  fun (layer-while-held fun)
  lfun (tap-hold $tap-time $hold-time bspc (layer-toggle fun))
  rfun (tap-hold $tap-time $hold-time esc (layer-toggle fun))
  l_ (tap-hold $tap-time $hold-pinky _ (layer-toggle swi))
  nav (tap-hold $tap-time $hold-time spc (layer-toggle nav))

  lcmd (tap-hold-press $tap-time $hold-time bspc lsft)
  rcmd (tap-hold $tap-time $hold-time ret (layer-toggle sym))
)

;; LAYERS ==============================================================================
;; -------------------------------------------------------------------------------------
;; main typing layers

(include eng_colemak-dh.kbd)
(include rus_qwerty.kbd)
(include gre_qwerty.kbd)


;; -------------------------------------------------------------------------------------
;; layer to switch betwen typing layers and toggle mods if any

(deflayer swi ;; switcher, layer to switch layers
 _    _   _   _   _   _       _   _   _   _   _    _   _   _
 _    _   _   _   _   _       _   _   _   _   _    _   _   _

 _    _   _ @rus @eng _       _ @eng @rus XX  _    _   _   _
 _    _   _ @gre @qwe _       _ @qwe @gre _   _    _   _
 _    _   _   _   _   _   _   _   _   _   _   _    _
 _    _   _   _   _   _   _
)

;; -------------------------------------------------------------------------------------
;; layers with extra buttons: numeric, symbol, function

(deflayer sym ;; symbol layer
@lfun   f1  f2  f3  f4  f5      f6  f7  f8  f9  f10    f11 f12 _
 _    _   _   _   _   _         _   _   _   _   _    _   _   _

 _ @!?  @<«  @=≈  @>»  @`       @lrd @[   @_  @]   @'  _   _   _
 _ @h$₽ @h{  @h-  @h}  @+±      @%°  @hlb @h; @hrb @h“ @racc  _
 _ @#№  @*   @:   @/\  @at  _   @^   @\   @~  @&   @|¦ _
 @lfun       _    _  @lfun  _   XX  _
)

(deflayer fun ;; function, media and keypad layer
 @app _   _   _   _   _         _   _   _   _   _    _   _   _
 _    _   _   _   _   _         _   _   _   _   _    _   _   _

 _  f12  f7  f8  f9 volu        0   1   2   3 @del   _   _   ret
 _ @f11 @f4 @f5 @f6 vold      ret @h4 @h5 @h6 @.,    _   _
 _  f10  f1  f2  f3 mute    _   0   7   8   9  .    _
 _   _        @app @lcmd  @nav  @rcmd @app
)

;; ------------------------------------------------------------------------------------------
;; layers for navigation, edition and function


(deflayer nav ;; navigation layer
 _        _    _    _    _    _        _    _    _    _    _      _   _   _
 f13     f1   f2   f3   f3   f5        f6   f7   f8   f9   f10    f11 f12 @lrd

 _  @qlz @cls @tlft @trgt @lnch        ins @home   up  @end @del  _   _   _
@hycps @all @ocm @mopt @S-T @prnt      @mcon left down rght bspc  _   _
 _  M-z M-x @cpyc C-S-tab @vstav C-tab mltp pgup @file pgdn @kill _
 _              _   @lfun @lcmd  @nav  @lfun @sym
)


(deflayer app
 _    _   _   _   _   _       _   _   _   _   _    _   _   _
 _    _   _   _   _   _       _   _   _   _   _    _   _   _

 _    _   _   _   _   _       _   _   _   _   _    _   _   _
 _ @anki _ @safari @emacs @ghostty _ _  _   _   _    _   _
 _  @zen  _   _   _   _   _   _   _   _   _   _    _
 _    _   _   _   _   _   _
)

(deflayer qwe ;; no remapping
 _    _   _   _   _   _       _   _   _   _   _    _   _   _
 _    _   _   _   _   _       _   _   _   _   _    _   _   _

 _    _   _   _   _   _       _   _   _  @l_  _    _   _   _
 _    _   _   _   _   _       _   _   _   _   _    _   _
 _    _   _   _   _   _   _   _   _   _   _   _    _
 _    _   _   _   _   _   _
)


;; -------------------------------------------------------------------------------------
;; combo definition

(defcfg
  concurrent-tap-hold yes
  ;;danger-enable-cmd yes
  process-unmapped-keys yes
)
(defchordsv2
  (e r) @eng $chord-time all-released    ( eng rus gre qwe sym fun nav )
  (j k) @eng $chord-time all-released    ( eng rus gre qwe sym fun nav )
  (k l) @rus $chord-time all-released    ( eng rus gre qwe sym fun nav )

  (e f) @''  $chord-time all-released    ( sym fun nav qwe )
  (j i) @“”  $chord-time all-released    ( sym fun nav qwe )
  (w r) @<>  $chord-time all-released    ( sym fun nav qwe )
  (s f) @{}  $chord-time all-released    ( sym fun nav qwe )
  (u o) @[]  $chord-time all-released    ( sym fun nav qwe )

  (f j) @ghoqui  $chord-time all-released ( eng rus )
  (f spc) @a⇥spc $chord-time all-released ( eng rus )
)

(defalias
  ;; extra letters which doesn't fit 10 columns and 3 rows
  ex[ (switch ((base-layer rus)) @rus[ break () @eng[ break)
  ex] (switch ((base-layer rus)) @rus] break () @eng] break)
  ex` (switch ((base-layer rus)) @rus` break () @eng` break)
  ex' (switch ((base-layer rus)) @rus' break () @eng' break)
)
