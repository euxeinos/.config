(deflayer eng
@lfun   🔅   🔆  _    _    _         _ ◀◀   ▶⏸   ▶▶   🔇   🔉   🔊   _

 _     1    2    3    4    5         6    7    8    9    0     -    _    _

 _     q  @lw   f    p    b         j    l    u   @ly  @;or'  [    ] _
@hyp  @ha  @hr  @hs  @ht   g          m  @hn  @he  @hi  @ho   @'or;  \
 _     z   x  c   d    v    `    k    h    @s1  @s2  @s3   rsft
 _            _  @lfun @lcmd   @nav  @rcmd @rfun
)

(defalias
  lw (tap-hold $tap-time $hold-pinky w (layer-toggle fun))
  ly (tap-hold $tap-time $hold-pinky y (layer-toggle swi))
  ht (tap-hold $tap-time $hold-index t lctl)
  hn (tap-hold $tap-time $hold-index n lctl)
  hr (tap-hold $tap-time $hold-ring r lmet)
  hi (tap-hold $tap-time $hold-ring i lmet)
  ha (tap-hold $tap-time $hold-pinky a (layer-toggle app))
  hs (tap-hold $tap-time $hold-middle s lalt)
  he (tap-hold $tap-time $hold-middle e lalt)
  ho (tap-hold $tap-time $hold-pinky o (layer-toggle app))
)

(environment (ALT_SYMBOLS "") (defalias ;or' ; 'or; ' s1 , s2 . s3 /))
(environment (ALT_SYMBOLS XELOR) (defalias ;or' ; 'or; ; s1 , s2 @.! s3 -))

(defalias
  eng[ [
  eng] ]
  eng` grv
  eng' @'or;
)
